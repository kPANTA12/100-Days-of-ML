{
 "cells": [
  {
   "cell_type": "markdown",
   "id": "f3b79b14-e143-439f-a572-7b93414d104d",
   "metadata": {},
   "source": [
    "# Transfer Leaerning"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "e1da4e81-bb8d-43dd-b6fc-4c633e15ff35",
   "metadata": {},
   "source": [
    "#### 1. Import Libraries"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 22,
   "id": "e5259f38-8bd3-4416-94db-01d7df9a4258",
   "metadata": {},
   "outputs": [],
   "source": [
    "import tensorflow as tf\n",
    "from tensorflow.keras.preprocessing.image import ImageDataGenerator\n",
    "from tensorflow.keras.applications import MobileNetV2\n",
    "from tensorflow.keras.models import Sequential\n",
    "from tensorflow.keras.layers import Dense, Flatten, GlobalAveragePooling2D\n",
    "import matplotlib.pyplot as plt"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "a2a21ed5-c971-4766-847b-fa3165973c20",
   "metadata": {},
   "source": [
    "#### 2. Load Dataset"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 11,
   "id": "62bad307-32e3-4d59-bd67-f9a3bec4f842",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Original shape: (50000, 32, 32, 3)\n"
     ]
    }
   ],
   "source": [
    "(X_train, y_train), (X_test, y_test) = tf.keras.datasets.cifar10.load_data()\n",
    "\n",
    "print(\"Original shape:\", X_train.shape)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "f55e7812-3500-49a0-89f1-f8d55e819fab",
   "metadata": {},
   "source": [
    "#### 3. Filter Only Cats and Dogs"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 12,
   "id": "b267b513-054b-44f4-addf-32ca48316f4e",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Filtered shape: (10000, 32, 32, 3)\n"
     ]
    }
   ],
   "source": [
    "train_filter = np.where((y_train == 3) | (y_train == 5))[0]\n",
    "test_filter = np.where((y_test == 3) | (y_test == 5))[0]\n",
    "\n",
    "X_train, y_train = X_train[train_filter], y_train[train_filter]\n",
    "X_test, y_test = X_test[test_filter], y_test[test_filter]\n",
    "\n",
    "# Convert labels: cat=0, dog=1\n",
    "y_train = (y_train == 5).astype(int)\n",
    "y_test = (y_test == 5).astype(int)\n",
    "\n",
    "print(\"Filtered shape:\", X_train.shape)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "3822e587-662c-4761-866c-b30f8571b8b6",
   "metadata": {},
   "source": [
    "#### 4. Resize Image"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 13,
   "id": "41e8540c-c17c-4c0d-9643-d49de9602a18",
   "metadata": {},
   "outputs": [],
   "source": [
    "X_train = tf.image.resize(X_train, (224, 224))\n",
    "X_test = tf.image.resize(X_test, (224, 224))"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "a82d30e7-ea2f-483e-914e-864278d711fe",
   "metadata": {},
   "source": [
    "#### 5. Normalize Data"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 14,
   "id": "fa412433-a4c5-4f34-8169-6e2f7068c057",
   "metadata": {},
   "outputs": [],
   "source": [
    "X_train = X_train / 255.0\n",
    "X_test = X_test / 255.0"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "af9b140d-adb3-43c5-af92-cf51adebeb75",
   "metadata": {},
   "source": [
    "#### 6. Visualize Sample Images"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 18,
   "id": "533f10b0-eca8-492d-9ddb-6a4d9b0842a8",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 640x480 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "plt.imshow(X_train[0])\n",
    "plt.title(\"Label: \" + str(y_train[0]))\n",
    "plt.axis(\"off\")\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "9034c7da-203c-41d5-af98-937bbe73fdd0",
   "metadata": {},
   "source": [
    "#### 7. Load Pretrained Model"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 19,
   "id": "389ba7eb-0026-433d-ac50-2bc3a3edbe35",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Downloading data from https://storage.googleapis.com/tensorflow/keras-applications/mobilenet_v2/mobilenet_v2_weights_tf_dim_ordering_tf_kernels_1.0_224_no_top.h5\n",
      "\u001b[1m9406464/9406464\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m1s\u001b[0m 0us/step\n"
     ]
    }
   ],
   "source": [
    "base_model = MobileNetV2(\n",
    "    weights='imagenet',\n",
    "    include_top=False,\n",
    "    input_shape=(224, 224, 3)\n",
    ")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "bdc082a9-db2c-456c-9596-2acd3e4a471c",
   "metadata": {},
   "source": [
    "#### 8. Freeze Base Layers"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 20,
   "id": "078687a6-406b-4fe3-a1c3-9d184b7efb82",
   "metadata": {},
   "outputs": [],
   "source": [
    "for layer in base_model.layers:\n",
    "    layer.trainable = False"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "fc7254d3-28da-4583-8966-09dc67eb3695",
   "metadata": {},
   "source": [
    "#### 9. Build Transfer Learning Model"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 23,
   "id": "847858b4-cb7d-4cdc-8373-3cf33013cfe7",
   "metadata": {},
   "outputs": [],
   "source": [
    "model = Sequential([\n",
    "    base_model,\n",
    "    GlobalAveragePooling2D(),\n",
    "    Dense(128, activation='relu'),\n",
    "    Dense(1, activation='sigmoid')\n",
    "])"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "b0a0f181-fd1f-457f-84d9-2b8e2c013da1",
   "metadata": {},
   "source": [
    "#### 10. Compile Model"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 24,
   "id": "c1dceb61-ffe2-48f0-9766-2102b4a69800",
   "metadata": {},
   "outputs": [],
   "source": [
    "model.compile(\n",
    "    optimizer='adam',\n",
    "    loss='binary_crossentropy',\n",
    "    metrics=['accuracy']\n",
    ")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "0b1c4cbe-ec06-4e32-a8f2-4af03da74c6d",
   "metadata": {},
   "source": [
    "#### 11. Train Model"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 25,
   "id": "1bf998c2-acd5-4e87-be11-431de833d8df",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Epoch 1/5\n",
      "\u001b[1m313/313\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m308s\u001b[0m 931ms/step - accuracy: 0.8021 - loss: 0.4202 - val_accuracy: 0.8185 - val_loss: 0.3873\n",
      "Epoch 2/5\n",
      "\u001b[1m313/313\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m293s\u001b[0m 933ms/step - accuracy: 0.8464 - loss: 0.3518 - val_accuracy: 0.8335 - val_loss: 0.3532\n",
      "Epoch 3/5\n",
      "\u001b[1m313/313\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m284s\u001b[0m 901ms/step - accuracy: 0.8513 - loss: 0.3348 - val_accuracy: 0.8310 - val_loss: 0.3637\n",
      "Epoch 4/5\n",
      "\u001b[1m313/313\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m275s\u001b[0m 873ms/step - accuracy: 0.8682 - loss: 0.3062 - val_accuracy: 0.8385 - val_loss: 0.3523\n",
      "Epoch 5/5\n",
      "\u001b[1m313/313\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m272s\u001b[0m 862ms/step - accuracy: 0.8760 - loss: 0.2851 - val_accuracy: 0.8275 - val_loss: 0.3538\n"
     ]
    }
   ],
   "source": [
    "history = model.fit(\n",
    "    X_train, y_train,\n",
    "    validation_data=(X_test, y_test),\n",
    "    epochs=5,\n",
    "    batch_size=32\n",
    ")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "8c18c8b5-112f-44e9-93cf-7cdb503bdb8f",
   "metadata": {},
   "source": [
    "#### 12. Evaluate Model"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 26,
   "id": "40e7eb12-fc47-4c47-ab7b-8b8ae0ee9b23",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "\u001b[1m63/63\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m44s\u001b[0m 694ms/step - accuracy: 0.8275 - loss: 0.3538\n",
      "Validation Accuracy: 0.8274999856948853\n"
     ]
    }
   ],
   "source": [
    "loss, accuracy = model.evaluate(X_test, y_test)\n",
    "print(\"Validation Accuracy:\", accuracy)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "57e0242e-37d0-4d43-99a6-8f0f1605302e",
   "metadata": {},
   "outputs": [],
   "source": []
  }
